---
import type { TeamMember } from "../data/content";

interface Props {
  member: TeamMember;
  photoSrc: string;
  panelPhotoSrc?: string;
}

const { member, photoSrc, panelPhotoSrc = photoSrc } = Astro.props;
const panelId = `panel-team-${member.slug}`;
---

<button class="card" type="button" data-panel-target={panelId} aria-haspopup="dialog">
  <img class="card__photo" src={photoSrc} alt={member.name} loading="lazy" />
  <span class="card__name">{member.name}</span>
  <span class="card__title">{member.title}</span>
</button>

<template id={panelId}>
  <img class="panel-photo" src={panelPhotoSrc} alt={member.name} />
  <div class="panel-header">
    <h2 class="panel-title">{member.name}</h2>
    {
      member.linkedin && (
        <a
          class="panel-linkedin"
          href={member.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${member.name} on LinkedIn`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
      )
    }
  </div>
  <p class="panel-oneliner">{member.title}</p>
  {
    member.bio ? (
      member.bio
        .split("\n\n")
        .map((paragraph) => <p class="panel-bio">{paragraph}</p>)
    ) : (
      <p class="founder-pending">Bio coming soon.</p>
    )
  }
</template>

<style>
  .card {
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card__photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
    margin-bottom: 1rem;
    background: rgba(0, 0, 0, 0.06);
  }

  .card__name {
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .card__title {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .panel-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    margin-bottom: 1.5rem;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .panel-title {
    font-size: 2rem;
    font-weight: 800;
    margin: 0;
  }

  .panel-oneliner {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0.25rem 0 2rem;
  }

  .panel-linkedin {
    flex-shrink: 0;
    display: flex;
    color: var(--color-text);
  }

  .panel-linkedin:hover,
  .panel-linkedin:focus-visible {
    color: var(--color-accent);
  }

  .panel-bio {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .panel-bio:last-of-type {
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .card {
      align-items: center;
      text-align: center;
    }
  }
</style>
