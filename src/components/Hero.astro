---
import { companies, thesisShowcaseOrder } from "../data/content";
import flextockTeam from "../assets/team-photos/flextock.webp";
import accordPartnersTeam from "../assets/team-photos/accord-partners.webp";
import rabbitTeam from "../assets/team-photos/rabbit.jpeg";
import flashqTeam from "../assets/team-photos/flashq.webp";
import swypexTeam from "../assets/team-photos/swypex.jpg";
import kenzzTeam from "../assets/team-photos/kenzz.webp";
import nowpayTeam from "../assets/team-photos/nowpay.webp";
import aydiTeam from "../assets/team-photos/aydi.jpg";
import sakneenTeam from "../assets/team-photos/sakneen.jpg";
import abwaabTeam from "../assets/team-photos/abwaab.jpg";

const teamPhotoMap: Record<string, string> = {
  flextock: flextockTeam.src,
  "accord-partners": accordPartnersTeam.src,
  rabbit: rabbitTeam.src,
  flashq: flashqTeam.src,
  swypex: swypexTeam.src,
  kenzz: kenzzTeam.src,
  nowpay: nowpayTeam.src,
  aydi: aydiTeam.src,
  sakneen: sakneenTeam.src,
  abwaab: abwaabTeam.src,
};

const showcase = thesisShowcaseOrder
  .map((slug) => companies.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c?.teamPhoto && c?.whyWeBacked));
---

<section class="hero">
  <div class="hero__carousel">
    <div class="hero__track" id="hero-track">
      <div class="hero__slide hero__slide--thesis">
        <p class="eyebrow reveal">Our Thesis</p>
        <h1 class="hero__headline reveal" style="transition-delay: 90ms">
          We back the<br /><span class="hero__highlight">people</span> who<br />redefine industries.
        </h1>
        <p class="hero__body reveal" style="transition-delay: 180ms">
          We are a pre-seed and seed investor in Egypt and Africa, backing founders
          often before anyone else does. We invest in people first: operators with
          deep insight into a problem, building technology-enabled companies that
          can define their industries. We commit early, and we stay close long
          after, giving our founders the largest access across the country.
        </p>
      </div>
      {
        showcase.map((company) => (
          <div class="hero__slide hero__slide--company">
            <p class="eyebrow">{company.name}</p>
            <div class="hero__company-row">
              <img
                class="hero__photo"
                src={teamPhotoMap[company.teamPhoto!]}
                alt={`${company.founders.map((f) => f.name).join(" and ")}, ${company.name}`}
                loading="lazy"
              />
              <div class="hero__why-col">
                <p class="hero__why-label">{company.showcaseLabel ?? "Why we backed this team"}</p>
                <p class="hero__why">{company.whyWeBacked}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {
      showcase.length > 0 && (
        <div class="hero__controls">
          <button class="hero__nav hero__nav--prev" id="hero-prev" type="button" aria-label="Previous">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6" />
            </svg>
          </button>
          <div class="hero__dots" id="hero-dots" />
          <button class="hero__nav hero__nav--next" id="hero-next" type="button" aria-label="Next">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 6rem var(--gutter) 2.5rem;
  }

  .hero__carousel {
    position: relative;
  }

  .hero__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .hero__track::-webkit-scrollbar {
    display: none;
  }

  .hero__slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
  }

  .hero__slide--thesis {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__headline {
    font-size: var(--text-h1-size);
    line-height: var(--text-h1-leading);
    font-weight: var(--text-h1-weight);
    color: var(--color-headline);
    margin: 0 0 1.75rem;
    max-width: 18ch;
  }

  .hero__highlight {
    color: var(--color-accent);
  }

  .hero__body {
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    color: var(--color-text-muted);
    max-width: var(--text-body-measure);
    margin: 0;
  }

  .hero__slide--company {
    flex-direction: column;
    align-items: stretch;
  }

  .hero__company-row {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    width: 100%;
  }

  .hero__photo {
    flex: 1.4 1 0;
    min-width: 0;
    width: 100%;
    height: 420px;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .hero__why-col {
    flex: 1 1 0;
    min-width: 0;
  }

  .hero__why-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }

  .hero__why {
    font-size: 1rem;
    line-height: var(--text-body-leading);
    color: var(--color-text);
    margin: 0;
  }

  .hero__controls {
    position: absolute;
    top: 0.1rem;
    right: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero__nav {
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0.5rem;
    margin: -0.5rem;
    color: var(--color-headline);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .hero__nav:hover,
  .hero__nav:focus-visible {
    color: var(--color-accent);
  }

  .hero__nav:disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  .hero__dots {
    display: flex;
    gap: 0.5rem;
  }

  .hero__dots :global(.hero__dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: var(--brand-grey-light-mid);
    cursor: pointer;
  }

  .hero__dots :global(.hero__dot.is-active) {
    background: var(--color-accent);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3.5rem var(--gutter) 1.75rem;
    }

    .hero__slide--company {
      gap: 1.25rem;
    }

    .hero__company-row {
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
    }

    .hero__photo {
      flex: 0 0 auto;
      width: 100%;
      height: 220px;
    }
  }
</style>

<script>
  const track = document.getElementById("hero-track");
  const prevBtn = document.getElementById("hero-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("hero-next") as HTMLButtonElement | null;
  const dotsContainer = document.getElementById("hero-dots");

  if (track) {
    const slides = Array.from(track.children) as HTMLElement[];
    const dots: HTMLButtonElement[] = [];

    if (slides.length > 1) {
      const realCount = slides.length;

      if (dotsContainer) {
        slides.forEach((_, i) => {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "hero__dot";
          dot.setAttribute("aria-label", `Go to slide ${i + 1}`);
          dot.addEventListener("click", () => scrollToIndex(i));
          dotsContainer.appendChild(dot);
          dots.push(dot);
        });
      }

      // Only clone the first slide, appended after the last one — scrolling
      // forward past the final slide lands on this visually identical clone,
      // which we then jump off of to the real first slide, instantly, for a
      // seamless forward loop. We deliberately do NOT also put a clone
      // before the first slide (which would be needed for an equally
      // seamless backward loop): doing that previously meant the page's
      // default scroll position — 0, before any of this script has run —
      // pointed at that leading clone instead of the real first slide. That
      // depended on this script finishing its correction before the browser
      // (or the user) could show that resting frame, which kept proving
      // fragile in slightly different ways across devices. Without a
      // leading clone, position 0 is correct unconditionally, with no JS
      // involved at all. The backward direction (previous-button only, from
      // the first slide) instead jumps to the real last slide with no
      // animation — not seamless, but not a rewind through every slide
      // either, and immune to the same race.
      const firstClone = slides[0].cloneNode(true) as HTMLElement;
      firstClone.setAttribute("aria-hidden", "true");
      // The clone stands in only for the loop illusion — force its
      // scroll-reveal elements (e.g. the thesis slide's title) straight to
      // the visible state so it never shows the fade-in/slide-up intro
      // while swiping onto it.
      firstClone.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      track.appendChild(firstClone);

      function currentIndex() {
        return Math.round(track!.scrollLeft / track!.clientWidth);
      }

      function scrollToIndex(i: number, behavior: ScrollBehavior = "smooth") {
        track!.scrollTo({ left: i * track!.clientWidth, behavior });
      }

      function updateDots(realIdx: number) {
        dots.forEach((d, i) => d.classList.toggle("is-active", i === realIdx));
      }

      // Jump to an index with no visible snap/momentum carry-over: briefly
      // drop scroll-snap so the browser's native snap engine can't keep
      // animating toward the old target after we've already moved.
      function hardJump(i: number) {
        track!.style.scrollSnapType = "none";
        track!.scrollTo({ left: i * track!.clientWidth, behavior: "instant" });
        void track!.offsetWidth;
        track!.style.scrollSnapType = "";
      }

      updateDots(0);

      prevBtn?.addEventListener("click", () => {
        const idx = currentIndex();
        if (idx <= 0) {
          hardJump(realCount - 1);
          updateDots(realCount - 1);
        } else {
          scrollToIndex(idx - 1);
        }
      });
      nextBtn?.addEventListener("click", () => scrollToIndex(currentIndex() + 1));

      let settleTimer: ReturnType<typeof setTimeout>;
      track.addEventListener("scroll", () => {
        updateDots(Math.min(currentIndex(), realCount - 1));
        clearTimeout(settleTimer);
        settleTimer = setTimeout(() => {
          if (currentIndex() === realCount) {
            // landed on the trailing clone of the first slide — jump back to
            // the real one instantly and invisibly
            hardJump(0);
            updateDots(0);
          }
        }, 150);
      });

      let lastWindowWidth = window.innerWidth;
      window.addEventListener("resize", () => {
        if (window.innerWidth === lastWindowWidth) return;
        lastWindowWidth = window.innerWidth;
        hardJump(Math.min(currentIndex(), realCount - 1));
      });
    } else {
      prevBtn?.remove();
      nextBtn?.remove();
    }
  }
</script>
