---
import fvLockupWhite from "../assets/logo/fv-lockup-white.png";
import { siteInfo } from "../data/content";
---

<header class="header">
  <div class="header__inner">
    <img class="header__logo" src={fvLockupWhite.src} alt="Foundation Ventures" />
    <nav class="header__links">
      <a
        class="header__link"
        href="https://eplit-foundation-ventures.replit.app/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Investors
      </a>
      <a class="header__link" href={`mailto:${siteInfo.email}`}>Builders</a>
    </nav>
    <button class="header__menu-toggle" id="header-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M2 6h18M2 11h18M2 16h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>

<div class="header__drawer-backdrop" id="header-drawer-backdrop" hidden></div>
<nav class="header__drawer" id="header-drawer" aria-hidden="true" hidden>
  <button class="header__drawer-close" id="header-drawer-close" type="button" aria-label="Close menu">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </button>
  <a
    class="header__drawer-link"
    href="https://eplit-foundation-ventures.replit.app/"
    target="_blank"
    rel="noopener noreferrer"
  >
    Investors
  </a>
  <a class="header__drawer-link" href={`mailto:${siteInfo.email}`}>Builders</a>
</nav>

<style>
  .header {
    background: var(--color-accent-bg);
    color: var(--color-on-accent);
  }

  .header__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--gutter);
  }

  .header__logo {
    height: 58px;
    width: auto;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header__link {
    text-decoration: none;
    color: #ffffff;
    white-space: nowrap;
    font-size: 1rem;
  }

  .header__menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.5rem;
    margin: -0.5rem;
    color: #ffffff;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .header__drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    transition: opacity var(--transition-panel);
    z-index: 92;
  }

  .header__drawer-backdrop.is-open {
    opacity: 1;
  }

  .header__drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 80vw);
    background: var(--color-bg-raised);
    color: var(--color-text);
    z-index: 93;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 4.5rem 2rem 2rem;
    transform: translateX(100%);
    transition: transform var(--transition-panel);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.25);
  }

  .header__drawer.is-open {
    transform: translateX(0);
  }

  .header__drawer-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: none;
    border: none;
    color: var(--color-accent);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
  }

  .header__drawer-link {
    text-decoration: none;
    color: var(--color-text);
    font-weight: var(--text-body-weight);
    font-size: 1.0625rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    .header__links {
      display: none;
    }

    .header__menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .header__logo {
      height: 44px;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById("header-menu-toggle") as HTMLButtonElement | null;
  const closeBtn = document.getElementById("header-drawer-close") as HTMLButtonElement | null;
  const backdrop = document.getElementById("header-drawer-backdrop") as HTMLElement | null;
  const drawer = document.getElementById("header-drawer") as HTMLElement | null;

  if (toggleBtn && closeBtn && backdrop && drawer) {
    function openDrawer() {
      backdrop!.hidden = false;
      drawer!.hidden = false;
      void drawer!.offsetWidth;
      backdrop!.classList.add("is-open");
      drawer!.classList.add("is-open");
      drawer!.setAttribute("aria-hidden", "false");
      toggleBtn!.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeBtn!.focus();
      document.addEventListener("keydown", onKeydown);
    }

    function closeDrawer() {
      backdrop!.classList.remove("is-open");
      drawer!.classList.remove("is-open");
      drawer!.setAttribute("aria-hidden", "true");
      toggleBtn!.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKeydown);

      const onTransitionEnd = () => {
        drawer!.hidden = true;
        backdrop!.hidden = true;
        drawer!.removeEventListener("transitionend", onTransitionEnd);
      };
      drawer!.addEventListener("transitionend", onTransitionEnd);

      toggleBtn!.focus();
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") closeDrawer();
    }

    toggleBtn.addEventListener("click", openDrawer);
    closeBtn.addEventListener("click", closeDrawer);
    backdrop.addEventListener("click", closeDrawer);
  }
</script>
