---
import type { Company } from "../data/content";

interface Props {
  company: Company;
  logoSrc: string;
  founderPhotoMap?: Record<string, string>;
}

const { company, logoSrc, founderPhotoMap = {} } = Astro.props;
const panelId = `panel-company-${company.slug}`;
const logoHeight = 32 * (company.logoScale ?? 1);

function initials(name: string) {
  return name
    .split(" ")
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}
---

<button class="tile" type="button" data-panel-target={panelId} aria-haspopup="dialog">
  <span class="tile__fund" aria-hidden="true">{company.fund}</span>
  <span class="tile__logo-row">
    <img
      class="tile__logo"
      src={logoSrc}
      alt={company.name}
      loading="lazy"
      style={`height: ${logoHeight}px`}
    />
    {company.logoNeedsLabel && <span class="tile__logo-label">{company.name}</span>}
  </span>
  {company.industry && <span class="tile__industry">{company.industry}</span>}
  <span class="tile__oneliner">{company.oneLiner}</span>
</button>

<template id={panelId}>
  <p class="eyebrow">{company.industry || company.name}</p>
  <h2 class="panel-title">{company.name}</h2>
  <p class="panel-oneliner">{company.oneLiner}</p>

  {
    company.founders.length > 0 ? (
      <ul class="founder-list">
        {company.founders.map((f) => (
          <li class="founder">
            {f.photo && founderPhotoMap[f.photo] ? (
              <img class="founder__photo" src={founderPhotoMap[f.photo]} alt={f.name} />
            ) : (
              <span class="founder__placeholder" aria-hidden="true">
                {initials(f.name)}
              </span>
            )}
            <span class="founder__name">{f.name}</span>
            <span class="founder__role">{f.role}</span>
            {f.linkedin ? (
              <a
                class="founder__linkedin"
                href={f.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${f.name} on LinkedIn`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
            ) : (
              <span class="founder__linkedin founder__linkedin--pending" title="LinkedIn link coming soon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </span>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="founder-pending">Founder details coming soon.</p>
    )
  }

  <a class="panel-website" href={company.website} target="_blank" rel="noopener noreferrer">
    Visit {company.name} →
  </a>
</template>

<style>
  .tile {
    background: var(--color-tile-bg);
    color: var(--color-tile-text);
    border: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 2.25rem 1.5rem;
    position: relative;
    min-height: 180px;
    box-shadow: inset 0 0 0 0 var(--color-accent);
    transition: box-shadow var(--transition-fast);
  }

  .tile:hover,
  .tile:focus-visible {
    box-shadow: inset 0 0 0 3px var(--color-accent);
  }

  .tile__fund {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tile-text-muted);
  }

  .tile__logo-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 42px;
    margin-bottom: 0.75rem;
  }

  .tile__logo {
    max-width: 160px;
    width: auto;
    object-fit: contain;
  }

  .tile__logo-label {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-logo);
  }

  .tile__industry {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tile-text-muted);
  }

  .tile__oneliner {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-tile-text);
    max-width: 32ch;
  }

  .panel-title {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 0.75rem;
  }

  .panel-oneliner {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .founder-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .founder {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    column-gap: 0.875rem;
    row-gap: 0.1rem;
  }

  .founder__photo,
  .founder__placeholder {
    grid-row: 1 / 3;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .founder__photo {
    background: var(--color-bg);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .founder__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.08);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .founder__name {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .founder__role {
    grid-column: 2;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .founder__linkedin {
    grid-row: 1 / 3;
    grid-column: 3;
    display: flex;
    color: var(--color-text);
  }

  .founder__linkedin:hover,
  .founder__linkedin:focus-visible {
    color: var(--color-accent);
  }

  .founder__linkedin--pending {
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .founder-pending {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 2rem;
  }

  .panel-website {
    display: inline-block;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid currentColor;
  }

  .panel-website:hover,
  .panel-website:focus-visible {
    color: var(--color-accent);
  }
</style>
