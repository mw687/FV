---
import fvLockupGrey from "../assets/logo/fv-lockup-darkgrey.png";
import { siteInfo } from "../data/content";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__col">
      <div class="footer__brand-row">
        <img class="footer__logo" src={fvLockupGrey.src} alt="Foundation Ventures" />
        <a class="footer__linkedin" href={siteInfo.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Foundation Ventures on LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
          </svg>
        </a>
      </div>
      <a class="footer__band" href={siteInfo.bandCapitalUrl} target="_blank" rel="noopener noreferrer">
        A Band Capital company
      </a>
      <a class="footer__sfdr" href="/sfdr-disclosures">SFDR Disclosures</a>
    </div>

    <div class="footer__col footer__col--addresses">
      <div>
        <p class="footer__city">Cairo</p>
        <p class="footer__address">{siteInfo.addresses.cairo}</p>
      </div>
      <div>
        <p class="footer__city">Amsterdam</p>
        <p class="footer__address">
          {siteInfo.addresses.amsterdam ?? "Address coming soon"}
        </p>
      </div>
    </div>

    <p class="footer__copyright">© Foundation Ventures {year}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-accent-bg);
    color: #3a3a3a;
    width: 100%;
  }

  .footer__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .footer__brand-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer__logo {
    height: 44px;
    width: auto;
  }

  .footer__sfdr,
  .footer__band {
    color: #3a3a3a;
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .footer__sfdr:hover,
  .footer__band:hover {
    text-decoration: underline;
  }

  .footer__linkedin {
    color: #3a3a3a;
    display: inline-flex;
  }


  .footer__copyright {
    grid-column: 1 / -1;
    text-align: right;
    font-size: 0.8125rem;
    opacity: 0.85;
    margin: 0.5rem 0 0;
  }

  .footer__col--addresses {
    flex-direction: row;
    justify-content: flex-end;
    gap: 2.5rem;
  }

  .footer__city {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.5rem;
  }

  .footer__address {
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    max-width: 22ch;
  }

  @media (max-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .footer__col--addresses {
      flex-direction: column;
      justify-content: flex-start;
      gap: 1.25rem;
    }

    .footer__copyright {
      text-align: left;
    }
  }
</style>
